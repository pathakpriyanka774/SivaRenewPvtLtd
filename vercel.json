{
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "src/App.js",
      "dest": "/"
    },
    {
      "src": "src/pages",
      "dest": "/solutions"
    },
    {
      "src": "build/static",
      "dest": "/static"
    },
    {
      "src": "/src/assets",
      "dest": "/assets"
    }
  ]
}
